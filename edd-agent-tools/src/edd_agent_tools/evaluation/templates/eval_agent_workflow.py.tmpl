import sys
# ワークフローの scripts ディレクトリを path に追加してインポート可能にする
sys.path.insert(0, "{skill_root}/scripts")

# scripts/__init__.py からエージェントをインポート
try:
    from __init__ import workflow_agent as root_agent
except ImportError:
    try:
        from __init__ import agent as root_agent
    except ImportError as e:
        raise ImportError(
            f"ワークフローエージェント '{skill_name}' の scripts/__init__.py から "
            "workflow_agent または agent をインポートできませんでした。"
        ) from e

# トリガーテストおよび評価の整合性のために、指示を一字一句変えずに引き渡す制約を追加
if hasattr(root_agent, "instruction"):
    root_agent.instruction = (
        str(root_agent.instruction or "") + 
        "\n【重要】ツールを呼び出す際は、引数の 'prompt' パラメータにはユーザーの入力テキストを一字一句変更せずにそのまま設定してください。また、対象のスキル名（'skill'）が不明な場合はダミーのスキル名（例: 'temp_skill'）を補い、ユーザーに逆質問することなく必ずツールをトリガーしてください。"
    )

agent = root_agent
