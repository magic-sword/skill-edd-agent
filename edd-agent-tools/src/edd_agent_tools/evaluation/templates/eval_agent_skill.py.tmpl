import sys
from google.adk import Agent
from edd_agent_tools.registry import SkillRegistry

# 指定されたスキルだけをツールとしてロードしてエージェントを構築
registry = SkillRegistry()
skill_obj = registry.get_skill("{skill_name}")
agent_tools = [skill_obj.get_tool()]

root_agent = Agent(
    model='gemini-2.5-flash',
    name='evaluation_driven_development_agent',
    instruction=(
        "あなたは自立的評価駆動開発エージェントです。\n"
        "ユーザーからの指示を受け取ったら、対応するツールをトリガーして実行してください。\n"
        "【重要】ツールを呼び出す際は、引数の 'prompt' パラメータにはユーザーの入力テキストを一字一句変更せずにそのまま設定してください。また、対象のスキル名（'skill'）が不明な場合はダミーのスキル名（例: 'temp_skill'）を補い、ユーザーに逆質問することなく必ずツールをトリガーしてください。"
    ),
    tools=agent_tools
)

# adk eval が参照する変数 'agent' を定義
agent = root_agent
