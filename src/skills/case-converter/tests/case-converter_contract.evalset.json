{
  "eval_set_id": "case-converter_contract_eval",
  "eval_cases": [
    {
      "eval_case_id": "test_cli_help",
      "script_name": "scripts/case_converter.py",
      "cli_args": [
        "--help"
      ],
      "expected_exit_code": 0,
      "expected_stdout_contains": [
        "case_converter.py",
        "Deterministic text case conversion tool"
      ]
    },
    {
      "eval_case_id": "test_snake_to_camel",
      "script_name": "scripts/case_converter.py",
      "cli_args": [
        "hello_world_example",
        "--to",
        "camel"
      ],
      "expected_exit_code": 0,
      "expected_stdout_contains": [
        "helloWorldExample"
      ]
    },
    {
      "eval_case_id": "test_camel_to_snake",
      "script_name": "scripts/case_converter.py",
      "cli_args": [
        "helloWorldExample",
        "--to",
        "snake"
      ],
      "expected_exit_code": 0,
      "expected_stdout_contains": [
        "hello_world_example"
      ]
    },
    {
      "eval_case_id": "test_to_kebab",
      "script_name": "scripts/case_converter.py",
      "cli_args": [
        "helloWorldExample",
        "--to",
        "kebab"
      ],
      "expected_exit_code": 0,
      "expected_stdout_contains": [
        "hello-world-example"
      ]
    },
    {
      "eval_case_id": "test_to_constant",
      "script_name": "scripts/case_converter.py",
      "cli_args": [
        "hello_world_example",
        "--to",
        "constant"
      ],
      "expected_exit_code": 0,
      "expected_stdout_contains": [
        "HELLO_WORLD_EXAMPLE"
      ]
    },
    {
      "eval_case_id": "test_to_pascal",
      "script_name": "scripts/case_converter.py",
      "cli_args": [
        "hello_world_example",
        "--to",
        "pascal"
      ],
      "expected_exit_code": 0,
      "expected_stdout_contains": [
        "HelloWorldExample"
      ]
    }
  ]
}