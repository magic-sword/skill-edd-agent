from google.adk.tools import ToolContext
from edd_agent_tools.skills import SkillsState
from edd_agent_tools import merge_result_to_state
import json

def $func_name(tool_context: ToolContext) -> str:
    # 設計書の inputs マッピングから直接決定論的に引数を抽出
    state = SkillsState()
    module = state.get_skill("$target_skill").load_module()
    
    res = module.$actual_func_name(
$params_init_str
    )
    return merge_result_to_state(tool_context, res)
