{
  "eval_set_id": "secret-sanitizer_edd_eval",
  "skill_name": "secret-sanitizer",
  "cases": [
    {
      "case_id": "secret_san_edd_001",
      "input": "Sanitize 'api_key: sk-1234567890abcdef1234' in this string",
      "expected_skill": "secret-sanitizer",
      "expected_tool_calls": [
        {
          "tool": "scripts/secret_sanitizer.py",
          "args": {"input": "api_key: sk-1234567890abcdef1234"}
        }
      ],
      "expected_output_format": "api_key: <API_KEY: ********>",
      "rubric": [
        "masks sensitive api_key credential",
        "invokes scripts/secret_sanitizer.py CLI tool",
        "preserves surrounding string structure"
      ]
    },
    {
      "case_id": "secret_san_edd_002",
      "input": "Mask email address 'admin@company.example.com' in string",
      "expected_skill": "secret-sanitizer",
      "expected_tool_calls": [
        {
          "tool": "scripts/secret_sanitizer.py",
          "args": {"input": "admin@company.example.com"}
        }
      ],
      "expected_output_format": "<EMAIL: ********>",
      "rubric": [
        "masks sensitive email address",
        "invokes scripts/secret_sanitizer.py CLI tool"
      ]
    },
    {
      "case_id": "secret_san_edd_003",
      "input": "Mask password in 'password = mySecretPass123'",
      "expected_skill": "secret-sanitizer",
      "expected_tool_calls": [
        {
          "tool": "scripts/secret_sanitizer.py",
          "args": {"input": "password = mySecretPass123"}
        }
      ],
      "expected_output_format": "password = <PASSWORD: ********>",
      "rubric": [
