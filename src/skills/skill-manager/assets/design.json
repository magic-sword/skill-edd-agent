{
  "name": "skill-manager",
  "description": "スキルのTierおよびメタデータを一括管理・登録します。",
  "execution_type": "tool",
  "output_mode": "VALUE_ONLY",
  "parameters": [
    {
      "name": "command",
      "type": "str",
      "description": "実行するコマンド",
      "required": true,
      "choices": [
        "register",
        "get-tier",
        "set-tier",
        "list",
        "update-meta"
      ]
    },
    {
      "name": "skill",
      "type": "str",
      "description": "対象のスキル名",
      "required": false,
      "default": null
    },
    {
      "name": "tier",
      "type": "int",
      "description": "設定するTier",
      "required": false,
      "default": null,
      "choices": [
        "0",
        "1",
        "2",
        "3"
      ]
    },
    {
      "name": "registry_path",
      "type": "str",
      "description": "レジストリファイルのカスタムパス",
      "required": false,
      "default": null
    }
  ],
  "dependencies": [],
  "constraints": [
    "commandが'register', 'get-tier', 'set-tier', 'update-meta'の場合、skillは必須です。",
    "commandが'set-tier'の場合、tierは必須です。"
  ],
  "response_parameters": null
}