import json
import argparse
import sys
from google.adk.tools import ToolContext

def process_message(tool_context: ToolContext):
    """
    ここにスキルのビジネスロジックを実装してください。
    - tool_context.state から必要なパラメータを取得します。
    - 処理結果を tool_context.state に格納します。
    """
    user_message = tool_context.state.get("user_message", "")
    
    # [TODO] ここに必要なロジックを実装してください。
    # 例: result_message = user_message.upper()
    result_message = user_message # プレースホルダー
    
    tool_context.state["result_message"] = result_message

def main():
    parser = argparse.ArgumentParser(description="Skill Script CLI Wrapper")
    parser.add_argument("--input_json", type=str, help="JSON string containing input parameters")
    parser.add_argument("--output_json", type=str, help="Path to write the output JSON to")

    args = parser.parse_args()
    tool_context = ToolContext()

    if args.input_json:
        try:
            input_data = json.loads(args.input_json)
            tool_context.state.update(input_data)
        except Exception as e:
            print(f"Error parsing input_json: {e}", file=sys.stderr)
            sys.exit(1)

    # ロジックを実行
    process_message(tool_context)

    # 常に結果を stdout に出力する（呼び出し元エージェントが結果を確認できるようにするため）
    result_json = json.dumps(tool_context.state, ensure_ascii=False, indent=2)
    print(result_json)

    # 指定があればファイルにも書き出す
    if args.output_json:
        try:
            with open(args.output_json, 'w', encoding='utf-8') as f:
                f.write(result_json)
        except Exception as e:
            print(f"Error writing to output_json: {e}", file=sys.stderr)
            sys.exit(1)

if __name__ == "__main__":
    main()
