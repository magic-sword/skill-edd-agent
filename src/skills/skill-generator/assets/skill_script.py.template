def process_message(params: Input, tool_context: ToolContext) -> str:
    """
    ここにスキルのビジネスロジックを実装してください。
    - params (Input) から型安全に必要なパラメータを取得します。
    - 状態の永続化が必要な結果は tool_context.state に格納します。
    - AI（LLM）へのテキストフィードバックとなる実行結果のサマリーを返します。
    """
    prompt = params.prompt
    
    # [TODO] ここに必要なビジネスロジックを実装してください。
    result_message = f"Processed: {prompt}"  # プレースホルダー
    
    tool_context.state["result_message"] = result_message
    
    return f"Success: {result_message}"
